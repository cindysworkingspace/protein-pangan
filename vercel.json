{
  "version": 2,
  "rewrites": [
    {
      "source": "/css/(.*)",
      "destination": "/web/css/$1"
    },
    {
      "source": "/js/(.*)",
      "destination": "/web/js/$1"
    },
    {
      "source": "/images/(.*)",
      "destination": "/web/images/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.go"
    },
    {
      "source": "/detail",
      "destination": "/web/detail.html"
    },
    {
      "source": "/compare",
      "destination": "/web/compare.html"
    },
    {
      "source": "/",
      "destination": "/web/index.html"
    }
  ]
}
